PORT=3001
NODE_ENV=development

# Optional. If empty, the service extracts a fresh key through Puppeteer.
PERCHANCE_USER_KEY=

PERCHANCE_CHANNEL=ai-text-to-image-generator
PERCHANCE_SUB_CHANNEL=public
PERCHANCE_STYLE=
PERCHANCE_NEGATIVE_PROMPT=
PERCHANCE_RESOLUTION=512x768
PERCHANCE_GUIDANCE_SCALE=7
PERCHANCE_HEADLESS=false
PERCHANCE_USER_DATA_DIR=.perchance-profile
PERCHANCE_VERIFICATION_TIMEOUT_MS=120000

REQUEST_TIMEOUT_MS=90000
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1200
GENERATED_DIR=generated
PUBLIC_BASE_URL=http://localhost:3001
